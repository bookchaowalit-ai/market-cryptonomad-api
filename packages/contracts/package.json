{
  "name": "@nomad-coin/contracts",
  "version": "1.0.0",
  "description": "Smart contracts for Nomad Coin",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mainnet",
    "clean": "hardhat clean",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol'"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.0",
    "@openzeppelin/contracts-upgradeable": "^4.9.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^1.1.0",
    "@openzeppelin/hardhat-upgrades": "^2.5.1",
    "dotenv": "^16.6.1",
    "hardhat": "^2.17.0",
    "prettier-plugin-solidity": "^1.1.0",
    "solhint": "^3.6.0"
  }
}
