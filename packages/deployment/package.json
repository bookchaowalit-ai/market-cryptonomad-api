{
  "name": "@nomad-coin/deployment",
  "version": "1.0.0",
  "description": "Deployment scripts and infrastructure for Nomad Coin",
  "scripts": {
    "build": "tsc",
    "deploy": "node dist/deploy.js",
    "deploy:testnet": "node dist/deploy.js --network testnet",
    "deploy:mainnet": "node dist/deploy.js --network mainnet",
    "verify": "node dist/verify.js",
    "setup-roles": "node dist/setup-roles.js",
    "upgrade": "node dist/upgrade.js",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "vitest"
  },
  "dependencies": {
    "hardhat": "^2.17.0",
    "@openzeppelin/hardhat-upgrades": "^2.0.0",
    "ethers": "^6.7.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "typescript": "^5.1.0",
    "@types/node": "^20.0.0",
    "vitest": "^0.34.0"
  }
}