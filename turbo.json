{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build", "test"],
      "outputs": ["deployments/**"]
    },
    "deploy:testnet": {
      "dependsOn": ["build", "test"],
      "outputs": ["deployments/**"]
    },
    "deploy:mainnet": {
      "dependsOn": ["build", "test"],
      "outputs": ["deployments/**"]
    }
  }
}